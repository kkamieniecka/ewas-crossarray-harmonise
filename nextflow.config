manifest {
    name            = 'ewas-harmonise'
    description      = 'Cross-array (450K + EPIC) harmonisation and ML region detection for longitudinal EWAS'
    author          = 'extends the EWASGalaxy tool suite (Murat et al. 2019)'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

// Declared here, not in main.nf: the report paths below are evaluated when
// the config is read, before the script sets its own defaults.
params.outdir = 'results'

// Reproducibility: every run records what it did. These files are the audit
// trail a longitudinal EWAS reanalysis needs, so they are on by default.
// The timestamp is a params assignment, not a `def`: Nextflow 25's strict config
// parser rejects variable declarations here ("cannot be mixed with config
// statements"), which is what the nf-core `def trace_timestamp` idiom used to do.
// overwrite is set so a rerun that lands in the same second does not abort.
params.trace_timestamp = new java.util.Date().format('yyyyMMdd-HHmmss')

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline-${params.trace_timestamp}.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report-${params.trace_timestamp}.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace-${params.trace_timestamp}.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag-${params.trace_timestamp}.html" }

process {
    errorStrategy = 'terminate'
    cpus   = 2
    memory = 8.GB

    withLabel: r_heavy {
        // reading 126 IDAT pairs in two array spaces is memory bound, not CPU bound
        cpus   = 2
        memory = 24.GB
        time   = 8.h
    }
    withLabel: py_heavy {
        // permutation + stability selection dominate; the TV solver is single threaded
        cpus   = 4
        memory = 16.GB
        time   = 12.h
    }
    withLabel: py_light {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
}

profiles {

    // Local conda: the R layer needs a source-installed Bioconductor stack on
    // platforms Bioconda does not build for (e.g. osx-arm64). See
    // conf/install_bioc.R -- run it once, then point R_LIBS_USER at its library.
    conda {
        conda.enabled = true
        process {
            withLabel: r_heavy  { conda = "${projectDir}/conf/env-r.yml" }
            withLabel: py_heavy { conda = "${projectDir}/conf/env-py.yml" }
            withLabel: py_light { conda = "${projectDir}/conf/env-py.yml" }
        }
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            withLabel: r_heavy  { container = 'bioconductor/bioconductor_docker:RELEASE_3_20' }
            withLabel: py_heavy { container = 'python:3.11-slim' }
            withLabel: py_light { container = 'python:3.11-slim' }
        }
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process {
            withLabel: r_heavy  { container = 'docker://bioconductor/bioconductor_docker:RELEASE_3_20' }
            withLabel: py_heavy { container = 'docker://python:3.11-slim' }
            withLabel: py_light { container = 'docker://python:3.11-slim' }
        }
    }

    // Fast smoke test: few permutations, no stability selection, no baseline.
    test {
        params.n_perm       = 10
        params.n_boot       = 5
        params.run_baseline = false
        params.naive_perm   = false
    }
}
